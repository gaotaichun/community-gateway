# Copy to .env, or let deploy.sh generate it for you.
# 这些是容器级变量；Discord 凭证与站点地址由 deploy.sh 通过后台 API 写入数据库，
# 不放在这里，避免和后台设置出现两份真相。

TZ=Asia/Shanghai
PORT=3000
SQLITE_PATH=/data/new-api.db

# 会话签名密钥，必须是随机值：openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-64-char-hex-string

NODE_NAME=community-gateway
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
GIN_MODE=release

# 全站每分钟请求上限（所有用户合计），0 = 不限。
# 这是最后一道闸，用来防止某个客户端写死循环把 Bifrost 打爆；
# 每小时 token 额度不在这里，在后台「套餐」页面按 token 设置。
GLOBAL_RATE_LIMIT_PER_MINUTE=30

# 容器需要出网代理时取消注释（注意 NO_PROXY 要放过本机与上游内网地址）
# HTTP_PROXY=http://172.17.0.1:7890
# HTTPS_PROXY=http://172.17.0.1:7890
# NO_PROXY=127.0.0.1,localhost,gateway
