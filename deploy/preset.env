# 预设值 —— 向导会把它当作默认值显示（直接回车即采用）。
#
# 这里只放**非密钥**信息。上游密钥必须由部署人现填，不进包、不进仓库。
#
# 优先级：命令行环境变量 > .deploy-config > .env > preset.local.env > 本文件。
# 想改就直接改这里，或者跑向导时手输覆盖。

# 上游（Bifrost）的根地址，**不要带 /v1**（网关自己会拼 /v1/chat/completions）。
#
# 如果网关和 Bifrost 跑在同一台机器上，**强烈建议填本机回环地址**，例如
#   UPSTREAM_BASE_URL=http://127.0.0.1:8080
# 这样流量不出网卡：不经过 Cloudflare Tunnel，不绕公网 DNS，不受隧道抖动影响，
# 延迟最低，也省掉一次 TLS 握手。公网域名（https://<域名>）只在 Bifrost 位于
# 另一台机器时才需要。
UPSTREAM_BASE_URL=https://<域名>

# 渠道里要登记的模型 ID，逗号分隔，不能有空格。
# 客户端请求时 model 字段填的就是下面这些字符串，必须和上游完全一致。
# 例：Z.ai/glm-5.3-flash,openrouter/minimax/minimax-m3
# 留空则向导会现问；填了就作为默认值。
UPSTREAM_MODELS=

# 全站每分钟请求上限（所有用户合计），0 = 不限。
# 每小时 token 额度不在这里，在后台「套餐」页面按 token 设置。
GLOBAL_RATE_LIMIT_PER_MINUTE=30
