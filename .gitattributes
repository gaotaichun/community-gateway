# 仓库里的 shell 脚本必须保持 LF，否则在 Linux 上 clone 下来会报
# "/usr/bin/env: 'bash\r': No such file or directory"。
* text=auto eol=lf

*.sh            text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf
*.py            text eol=lf
*.go            text eol=lf
*.mjs           text eol=lf
*.md            text eol=lf
*.env           text eol=lf
*.example       text eol=lf
*.dockerignore  text eol=lf

*.png binary
*.jpg binary
